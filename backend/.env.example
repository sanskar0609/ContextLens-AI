# ============================================================
# ContextLens AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Server Configuration ---
HOST=127.0.0.1
PORT=8000

# --- CORS (comma-separated list of allowed origins) ---
# For development, allow the Chrome extension and localhost
ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID

# --- Google Gemini API ---
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Path where ChromaDB will persist its data locally
CHROMA_PERSIST_DIRECTORY=./chroma_db

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
