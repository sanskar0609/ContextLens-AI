{
    "manifest_version": 3,
    "name": "ContextLens AI",
    "version": "1.0.0",
    "description": "Chat with an AI about the content of any webpage using Google Gemini.",
    "permissions": [
        "sidePanel",
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://localhost:8000/*"
    ],
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/extractor.js",
                "content/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],
    "side_panel": {
        "default_path": "index.html"
    },
    "action": {
        "default_title": "Open ContextLens AI"
    },
   
    "web_accessible_resources": [
        {
            "resources": [
                "content/extractor.js",
                "content/content.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}